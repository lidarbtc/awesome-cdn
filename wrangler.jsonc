{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cache-box",
  "account_id": "35b3305bfd095935de7070f4d99d6929",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cache.box", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
